# El modelo de Angri: Qwen3.5 4B, siempre prendido. Lo usan la charla, el bucle de fondo y el sueño.
[Unit]
Description=Angri - modelo (Qwen3.5 4B)
After=network.target

[Service]
User=angri
Group=angri
ExecStart=/opt/angri/llama/bin/llama-server \
  -m /opt/angri/modelos/Qwen3.5-4B-Q4_K_M.gguf \
  --host 127.0.0.1 --port 8082 \
  -t 4 -c 8192 --jinja \
  --chat-template-kwargs '{"enable_thinking":false}'
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
